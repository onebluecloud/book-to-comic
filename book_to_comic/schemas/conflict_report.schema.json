{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book-to-comic.local/schemas/conflict_report.schema.json",
  "title": "Book to Comic Conflict Report",
  "type": "object",
  "required": ["schema_version", "passed", "metrics", "issues"],
  "properties": {
    "schema_version": { "const": "3.0" },
    "passed": { "type": "boolean" },
    "metrics": { "type": "object" },
    "issues": { "type": "array" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Book To Comic Panel Assets",
  "type": "object",
  "required": ["schema_version", "episode_id", "panels"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string" },
    "episode_id": { "type": "string" },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["panel_id", "asset_path", "status"],
        "additionalProperties": true,
        "properties": {
          "panel_id": { "type": "string" },
          "asset_path": { "type": "string" },
          "status": { "type": "string" },
          "sha256": { "type": "string" },
          "width": { "type": "integer" },
          "height": { "type": "integer" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/book-to-comic/style-preset.schema.json",
  "title": "Book-to-Comic Style Preset",
  "type": "object",
  "required": [
    "display_name",
    "short_name",
    "taxonomy",
    "selection",
    "art_direction",
    "prompt_blocks",
    "qa",
    "substyles",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "short_name": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy": {
      "type": "object",
      "required": [
        "tradition",
        "format",
        "medium",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "tradition": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "best_for",
        "avoid_for",
        "variants",
        "platforms"
      ],
      "additionalProperties": false,
      "properties": {
        "best_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "art_direction": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "array",
          "object",
          "boolean"
        ]
      }
    },
    "prompt_blocks": {
      "type": "object",
      "required": [
        "style_core",
        "character",
        "environment",
        "camera",
        "avoid"
      ],
      "additionalProperties": false,
      "properties": {
        "style_core": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "character": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "environment": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "camera": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "qa": {
      "type": "object",
      "required": [
        "signature",
        "hard_fail"
      ],
      "additionalProperties": false,
      "properties": {
        "signature": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3
        },
        "hard_fail": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3
        }
      }
    },
    "substyles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "use_when",
          "avoid_when",
          "visual_traits",
          "prompt_additions",
          "qa_focus",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "use_when": {
            "type": "string",
            "minLength": 1
          },
          "avoid_when": {
            "type": "string",
            "minLength": 1
          },
          "visual_traits": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2
          },
          "prompt_additions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "qa_focus": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S[0-9]{2}$"
            },
            "minItems": 1
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^S[0-9]{2}$"
      },
      "minItems": 1
    }
  }
}
